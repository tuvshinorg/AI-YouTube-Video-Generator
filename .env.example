# ─────────────────────────────────────────────────────────────────────────────
# AI YouTube Video Generator — user configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Absolute path to this repository on your machine.
# Leave empty to auto-detect (directory of pipeline.py).
BASE_DIR=

# ── AI text provider ──────────────────────────────────────────────────────────
# "llama" (default) = local llama.cpp, below. "codex" = shell out to the
# Codex CLI (https://github.com/openai/codex) instead — text/scene
# generation only, it has no image capability, so FLUX_* below still
# applies either way.
#
# Codex auth is whatever `codex login` on this machine is signed into. If
# that's a ChatGPT Plus/Pro login (not an API key), be aware: that login is
# designed for interactive terminal use on one device, not unattended
# backend automation — using it this way may run against OpenAI's usage
# terms. That's a call only you can make for your own account.
AI_PROVIDER=llama
CODEX_TIMEOUT=120

# ── LLM (llama.cpp) ──────────────────────────────────────────────────────────
# Path to your GGUF model file.  Download example:
#   huggingface-cli download bartowski/Llama-3.2-3B-Instruct-GGUF \
#       Llama-3.2-3B-Instruct-Q6_K.gguf --local-dir ./models
LLAMA_MODEL_PATH=./models/Llama-3.2-3B-Instruct-Q6_K.gguf

# Context window size in tokens.
LLAMA_N_CTX=4096

# Number of model layers to offload to GPU.
# -1 = all layers on GPU (fastest), 0 = CPU only.
LLAMA_N_GPU=-1

# Show llama.cpp token-by-token output (true/false).
LLAMA_VERBOSE=false

# ── Image provider ───────────────────────────────────────────────────────────
# "flux" (default) = local HuggingFace Flux, below. "openai" = OpenAI Images
# API (needs OPENAI_API_KEY — a separate, billed API key from
# platform.openai.com). "codex" = Codex CLI's built-in image_gen tool —
# rides on the same Codex/ChatGPT login as AI_PROVIDER=codex above, no
# separate API key or billing (same usage-terms caveat as AI_PROVIDER=codex
# applies here too if your login is a ChatGPT Plus/Pro plan).
IMAGE_PROVIDER=flux
CODEX_IMAGE_TIMEOUT=240
# Wait (seconds) between successive Codex image calls (references + scenes)
# to stay under its usage limit. Increase if you're still hitting the limit.
CODEX_IMAGE_DELAY=180
# Every `codex exec` call is killed early if it produces zero activity (no
# tool call has even started) for this long — catches a genuinely hung
# call fast without cutting off one that's just slow to start. Increase
# this if you see "no activity for Ns" failures on a slow connection.
CODEX_STARTUP_IDLE_TIMEOUT=180

# ── Image generation (HuggingFace Flux) ──────────────────────────────────────
# Any FLUX-compatible model repo on HuggingFace.  Examples:
#   black-forest-labs/FLUX.1-dev
#   black-forest-labs/FLUX.1-schnell
#   enhanceaiteam/Flux-Uncensored-V2
FLUX_MODEL_ID=enhanceaiteam/Flux-Uncensored-V2

# Offload model layers to CPU when not in use (saves VRAM).
# Set to false only if you have ≥24 GB VRAM.
FLUX_CPU_OFFLOAD=true

# Output image size (vertical/portrait for YouTube Shorts).
FLUX_WIDTH=540
FLUX_HEIGHT=960
FLUX_STEPS=20
FLUX_GUIDANCE=3.5

# ── Image generation (OpenAI Images API) ─────────────────────────────────────
# Used only when IMAGE_PROVIDER=openai. Get a key at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Portrait, to match FLUX_WIDTH/HEIGHT's aspect for YouTube Shorts.
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_TIMEOUT=120

# ── Text-to-speech ────────────────────────────────────────────────────────────
# Any voice supported by edge-tts.  Run `edge-tts --list-voices` to see all.
TTS_VOICE=en-US-AvaNeural
# Auto-selected instead of TTS_VOICE for any scene whose narration text is
# detected as Mongolian (real language ID via fastText's lid.176 model —
# not a Cyrillic-script guess, which can't tell Mongolian apart from
# Russian/Ukrainian/Kazakh etc.). Model auto-downloads (~1MB) on first use.
TTS_VOICE_MN=mn-MN-YesuiNeural

# ── Subtitles (Whisper) ───────────────────────────────────────────────────────
# Generic OpenAI Whisper ("medium") transcribes every scene except ones
# detected as Mongolian (same language-ID check as TTS_VOICE_MN above) —
# those use this HuggingFace-format fine-tune instead, which is
# substantially more accurate on Mongolian speech.
WHISPER_MODEL_MN=Tsedee/whisper-large-v3-turbo-mn-2

# ── YouTube upload ────────────────────────────────────────────────────────────
# Leave these as-is unless you moved the credential files.
# client_secret.json and credentials.storage must be placed in BASE_DIR.
# Follow docs/youtube-auth.md to generate them.
YT_CLIENT_SECRET=client_secret.json
YT_CREDENTIALS=credentials.storage

# ── Flutter manager app (api.py / backend.exe) ───────────────────────────────
# Port for `python api.py` / `make api` dev mode. The Flutter app's spawned
# backend.exe always uses an OS-assigned port instead, ignoring this.
API_PORT=8000

# Required only inside a frozen backend.exe (built via `make backend-exe`).
# sys.executable there is the exe itself, not a real interpreter, so
# pipeline.py needs to be launched with this instead. Point it at the same
# Python this project's dependencies are installed into.
# PYTHON_EXECUTABLE=C:\Users\you\AppData\Local\Programs\Python\Python311\python.exe

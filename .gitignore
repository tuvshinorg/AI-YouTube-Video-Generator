# Credentials and secrets
/client_secret.json
/credentials.storage

# Database files
main.db

# Media files (too large for git) — song/ is the exception, it's the
# small licensed music library the app ships with and reads at runtime.
optic/
*.mp4
*.mp3
*.wav
!song/**

# Temporary files
temp/
final/
logs/

# Downloaded/generated models (Llama GGUF, fastText lid.176, etc.) — fetched
# automatically or via a documented manual step, never committed.
models/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.env

# PyInstaller build output for backend.exe (backend.spec stays tracked)
/build/
/dist/
app/windows/backend/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db